[Unit]
Description=Jarvis — личная мультиагентная система
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jarvis
Group=jarvis
WorkingDirectory=/opt/jarvis
Environment=JARVIS_CONFIG=/opt/jarvis/config/jarvis.yaml
Environment=JARVIS_DB=/var/lib/jarvis/jarvis.db
Environment=HOME=/var/lib/jarvis
# Секреты приходят из Infisical при старте и живут только в памяти процесса.
ExecStart=/opt/jarvis/deploy/run-with-secrets.sh /opt/jarvis/.venv/bin/python -m jarvis run
Restart=on-failure
RestartSec=10
# Ограничения процесса
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/jarvis

[Install]
WantedBy=multi-user.target
